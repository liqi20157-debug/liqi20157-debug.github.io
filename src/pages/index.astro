---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import EntryList from "../components/EntryList.astro";
import NewsList from "../components/NewsList.astro";
import PubItem from "../components/PubItem.astro";
import DemoNotice from "../components/DemoNotice.astro";
import TemplateCta from "../components/TemplateCta.astro";
import { site, absoluteUrl } from "../site.config.js";
import {
  profile,
  about,
  news,
  education,
  publications,
  workingPapers,
  experience,
  projects,
  patents,
  awards,
  teaching,
  lastUpdated,
} from "../data.js";

const title = [profile.nameCn, profile.nameEn].filter(Boolean).join("  ");

// Structured data, assembled from the same content the page renders — nothing
// to keep in sync by hand. Institutions you list an `url` for in `education`
// become `alumniOf`; external profile links become `sameAs`.
const email = profile.links.find((l) => l.href.startsWith("mailto:"))?.href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.nameEn,
  ...(profile.nameCn && { alternateName: profile.nameCn }),
  url: absoluteUrl("/"),
  jobTitle: site.seo.jobTitle,
  description: site.description,
  ...(email && { email }),
  ...(site.seo.affiliation && {
    affiliation: { "@type": "CollegeOrUniversity", ...site.seo.affiliation },
  }),
  alumniOf: education
    .filter((e) => e.url && e.org !== site.seo.affiliation?.name)
    .map((e) => ({
      "@type": "CollegeOrUniversity",
      name: e.org,
      sameAs: e.url,
    })),
  ...(site.seo.location && {
    homeLocation: {
      "@type": "Place",
      address: {
        "@type": "PostalAddress",
        addressLocality: site.seo.location.locality,
        addressCountry: site.seo.location.country,
      },
    },
  }),
  knowsAbout: site.seo.knowsAbout,
  sameAs: profile.links
    .filter((l) => /^https?:/.test(l.href))
    .map((l) => l.href),
};
---

<Base title={title} path="/" jsonLd={jsonLd}>
  {site.demoNotice && <DemoNotice repo={site.repo} />}

  {/* Full-bleed masthead: the rule spans the viewport while the name inside
      lines up with the content below. */}
  <header class="site-header">
    <h1>
      {profile.nameCn && <span class="cn">{profile.nameCn}</span>}
      {profile.nameCn && profile.nameEn && <span aria-hidden="true">&nbsp;&nbsp;</span>}
      {profile.nameEn}
    </h1>
  </header>

  <div class="page">
    <Sidebar />

    {/* Every section below disappears on its own when its array in
        src/data.js is empty. To reorder the page, move these blocks. */}
    <main>
      {
        about.length > 0 && (
          <Section id="about" title="个人简介">
            <div class="prose">
              {about.map((para) => (
                <p set:html={para} />
              ))}
            </div>
          </Section>
        )
      }

      {
        news.length > 0 && (
          <Section id="news" title="动态">
            <NewsList items={news} />
          </Section>
        )
      }

      {
        education.length > 0 && (
          <Section id="education" title="教育背景">
            <EntryList items={education} />
          </Section>
        )
      }

      {
        publications.length > 0 && (
          <Section id="publications" title="代表性论文">
            <p class="section-note muted"><sup>#</sup> 表示共同第一作者</p>
            <div class="pubs">
              {publications.map((p) => (
                <PubItem {...p} />
              ))}
            </div>
          </Section>
        )
      }

      {
        workingPapers.length > 0 && (
          <Section id="working-papers" title="在研论文">
            <div class="pubs">
              {workingPapers.map((p) => (
                <PubItem {...p} />
              ))}
            </div>
          </Section>
        )
      }

      {
        experience.length > 0 && (
          <Section id="experience" title="工作经历">
            <EntryList items={experience} />
          </Section>
        )
      }

      {
        projects.length > 0 && (
          <Section id="projects" title="科研项目">
            <EntryList items={projects} />
          </Section>
        )
      }

      {
        patents.length > 0 && (
          <Section id="patents" title="专利与成果">
            <EntryList items={patents} />
          </Section>
        )
      }

      {
        awards.length > 0 && (
          <Section id="awards" title="荣誉与奖励">
            <EntryList items={awards} />
          </Section>
        )
      }

      {
        teaching.length > 0 && (
          <Section id="teaching" title="教学经历">
            <EntryList items={teaching} />
          </Section>
        )
      }

      {site.demoNotice && <TemplateCta repo={site.repo} />}

      <footer>更新于 {lastUpdated}</footer>
    </main>
  </div>
</Base>
